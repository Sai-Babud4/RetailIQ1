# RetailIQ – Intelligent Inventory Intelligence
# Environment Configuration

# Database (Default: local SQLite database in data directory)
DATABASE_URL=sqlite:///data/retailiq.db

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Make.com Automation Integration (Optional)
# Enter your custom webhook URL from Make.com
MAKECOM_WEBHOOK_URL=

# Optional OpenAI Integration (Optional - System operates 100% locally with deterministic AI engine)
OPENAI_API_KEY=

